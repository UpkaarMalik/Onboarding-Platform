# --- App ---
PORT=3000
NODE_ENV=development

# --- Database (Postgres) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onboarding?schema=public"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

# --- Session (DB-backed) ---
SESSION_ABSOLUTE_TTL_MS=604800000    # 7 days
SESSION_IDLE_TTL_MS=86400000         # 24 hours

# --- Cookies ---
CORS_ORIGIN="http://localhost:5173"
COOKIE_SAMESITE="lax"
# COOKIE_SECURE="true"      # forced true in production, only set to override
# COOKIE_DOMAIN=".prod.example.com"

# --- TOTP ---
TOTP_ISSUER="Onboarding Platform"

# --- Login identity domains ---
# Synthetic temp-login-email domain (never a real, deliverable address).
LOGIN_EMAIL_DOMAIN="id.onboarding.internal"
# Real company email domain — auto-generated as name@COMPANY_EMAIL_DOMAIN
# (name1@, name2@, ... on collision) when HR provisions a company email.
COMPANY_EMAIL_DOMAIN="example.com"

# --- SMTP (Nodemailer) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="no-reply@example.com"
SMTP_PASS="change-me"
SMTP_FROM="Onboarding Platform <no-reply@example.com>"

# --- Testing override -------------------------------------------------
# Mobile OTP login issues a FIXED code of 123456 to every account, so the
# flow can be exercised without reading the code out of the server log.
# The code is still hashed, still expires, and still counts against the
# attempt limit — only its value is predictable.
# Set to false for real random codes. Ignored entirely (always off) when
# NODE_ENV=production.
AUTH_FIXED_OTP=true
