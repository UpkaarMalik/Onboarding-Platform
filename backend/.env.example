# --- App ---
PORT=3000
NODE_ENV=development

# --- Database (Postgres) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
DATABASE_URL="postgresql://upkaarmalik:postgres@localhost:5432/onboarding_db"

# --- Auth ---
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN="15m"

# --- Session (server-side, DB-backed) ---
# Absolute cap on a session's lifetime, in ms. After this the refresh
# cookie stops working regardless of activity.
SESSION_ABSOLUTE_TTL_MS=604800000    # 7 days
# Idle cap. Pushed forward on every refresh; if the browser goes quiet
# past this, the session dies even if the absolute cap is still ahead.
SESSION_IDLE_TTL_MS=86400000         # 24 hours

# --- Cookies ---
# Comma-separated list. CORS + credentials requires an explicit origin.
CORS_ORIGIN="http://localhost:5173"
# `lax` works for localhost-to-localhost dev; production on a different
# hostname needs `none` + COOKIE_SECURE=true (which forces HTTPS).
COOKIE_SAMESITE="lax"
# Unset defaults to `NODE_ENV === production`.
# COOKIE_SECURE="false"
# COOKIE_DOMAIN=".example.com"

# --- Pre-auth / mobile OTP ---
JWT_PREAUTH_SECRET="test-preauth-secret"
JWT_PREAUTH_EXPIRES_IN="30m"
COMPANY_EMAIL_DOMAIN="example.com"